---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SourceSnapshot from '../components/SourceSnapshot.astro';
import { SITE_NAME, SITE_SHORT_NAME, SITE_URL, TELEPHONE, MAPS_SHARE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = '/icons/apple-touch-icon.png', imageAlt = SITE_NAME, jsonLd, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : SITE_URL + Astro.url.pathname;
const absoluteImage = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : Astro.site
    ? new URL(image, Astro.site).toString()
    : SITE_URL + image;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07313a" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE_SHORT_NAME} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}


  </head>
  <body>
    <Header />
    <main id="main-content"><slot />{!noindex && !['/privacy/','/terms/','/cookies/'].includes(Astro.url.pathname) && <SourceSnapshot />}</main>
    <div class="lg:hidden border-t border-white/10 bg-[#062d35]">
      <div class="grid grid-cols-3">
        <a href={`tel:${TELEPHONE}`} class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-bold text-white"><span class="text-lg leading-none">📞</span>電話</a>
        <a href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-bold text-white border-x border-white/10"><span class="text-lg leading-none">🧭</span>導航</a>
        <a href="/hours/" class="flex flex-col items-center justify-center gap-1 py-3 text-xs font-bold text-white"><span class="text-lg leading-none">🕐</span>營業時間</a>
      </div>
    </div>
    <section id="photo-credits" class="shell photo-attribution"><h2>照片來源、授權與修改</h2><p>照片是不同地點的歷史記錄，不表示市場建築外觀、今日設施或可通行路線。兩張照片均縮小、重新壓縮，顯示時可能裁切。</p><ul><li><a href="https://commons.wikimedia.org/wiki/File:%E5%B1%8F%E6%9D%B1%E7%B8%A3%E6%9D%B1%E6%B8%AF%E6%BC%81%E6%B8%AF.jpg">東港漁港（豐漁橋下方所攝）</a> · 雅婕 · 2020-09-06 · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>；修改後照片亦依相同授權提供。</li><li><a href="https://commons.wikimedia.org/wiki/File:Dapeng_Bay_National_Scenic_Area,_Tourism_Administration_1.jpg">Dapeng Bay National Scenic Area, Tourism Administration 1.jpg</a> · 交通部觀光署 · 2022-01-01 · <a href="https://admin.taiwan.net.tw/English/Others/Articles?a=106">政府網站資料開放宣告</a>。</li></ul></section>
    <Footer />
    <aside id="cookie-banner" data-open="false" class="cookie-banner" aria-label="分析偏好"><p>Google Analytics 預設關閉，僅在您允許後載入。Google 地圖是另行載入的外部服務。</p><div><button id="cookies-essential" type="button">拒絕分析</button><button id="cookies-accept" type="button">允許分析</button><a href="/cookies/">詳細設定</a></div><p id="cookie-banner-status" role="status"></p></aside>
    <script is:inline src="/consent.js" defer></script>
    <script is:inline>
      document.getElementById('mobile-menu-toggle')?.addEventListener('click', (event) => {
        const button = event.currentTarget;
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        document.getElementById('mobile-menu')?.toggleAttribute('hidden', !open);
      });
      if ('serviceWorker' in navigator) navigator.serviceWorker.getRegistrations().then((items) => {
        for (const item of items) if (item.active && new URL(item.active.scriptURL).pathname === '/sw.js') item.unregister();
      }).catch(() => {});
      if ('caches' in window) caches.keys().then((keys) => Promise.all(keys.filter((key) => key.startsWith('huaqiao') || key.startsWith('donggang')).map((key) => caches.delete(key)))).catch(() => {});
    </script>
  </body>
</html>
