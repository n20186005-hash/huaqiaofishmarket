---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import {
  ATTRACTION_FULL_NAME,
  ATTRACTION_SHORT_NAME,
  ATTRACTION_EN_NAME,
  ATTRACTION_TYPE,
  CITY_NAME,
  CITY_SHORT,
  STATE_PROVINCE,
  COUNTRY_NAME,
  COUNTRY_CODE_2LETTER,
  POSTAL_CODE,
  LATITUDE,
  LONGITUDE,
  STREET_ADDRESS,
  PLUS_CODE,
  TELEPHONE,
  TELEPHONE_DISPLAY,
  MAPS_SHARE_URL,
  MAPS_EMBED_SRC,
  NEARBY_LANDMARK_1,
  NEARBY_LANDMARK_2,
  GOVT_TOURISM_URL,
  GOVT_TOURISM_NAME,
  GOVT_SCENIC_URL,
  GOVT_SCENIC_NAME,
  RATING_VALUE,
  RATING_COUNT,
  RATING_SOURCE_NOTE,
  SITE_NAME,
  SITE_URL
} from '../data/site';

const pageTitle = `東港華僑市場（漁產品直銷中心）｜營業時間、交通停車、黑鮪魚海鮮美食攻略`;
const pageDescription = `屏東東港華僑市場（東港漁港漁產品直銷中心）攻略：營業時間與每月清潔公休、停車場指引、黑鮪魚生魚片與旗魚黑輪等必吃海鮮、代客料理，以及周邊${NEARBY_LANDMARK_1}、${NEARBY_LANDMARK_2}怎麼玩。Google 評分 ${RATING_VALUE}/5（${RATING_COUNT.toLocaleString('en-US')} 則）。`;
const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : SITE_URL;
const publicImage = (fileName: string, remote: string) => {
  const path = resolve(process.cwd(), 'public', 'images', fileName);
  return existsSync(path) ? `/images/${fileName}` : remote;
};
const localMarketPath = resolve(process.cwd(), 'public', 'images', 'market-exterior.jpg');
const hasLocalMarketPhoto = existsSync(localMarketPath);
const imageUrl = publicImage('market-exterior.jpg', 'https://www.taiwan.net.tw/att/1/big_scenic_spots/pic_A12-00342_14.jpg');
const harborImage = publicImage('donggang-harbor.jpg', 'https://upload.wikimedia.org/wikipedia/commons/9/9a/%E5%B1%8F%E6%9D%B1%E7%B8%A3%E6%9D%B1%E6%B8%AF%E6%BC%81%E6%B8%AF.jpg');
const bridgeImage = publicImage('dapeng-bay-bridge.jpg', 'https://upload.wikimedia.org/wikipedia/commons/7/7b/Dapeng_Bay_National_Scenic_Area%2C_Tourism_Administration_1.jpg');
const hasOgCover = existsSync(resolve(process.cwd(), 'public', 'images', 'og-cover.jpg'));
const ogCoverPath = hasOgCover ? '/images/og-cover.jpg' : '/icons/apple-touch-icon.png';
const metaImage = hasLocalMarketPhoto ? '/images/market-exterior.jpg' : ogCoverPath;
const siteOrigin = (Astro.site ?? new URL(SITE_URL)).toString().replace(/\/$/, '');
const schemaImages = [
  ...(hasLocalMarketPhoto ? [`${siteOrigin}/images/market-exterior.jpg`] : []),
  ...(hasOgCover ? [`${siteOrigin}/images/og-cover.jpg`] : [])
];
const schemaImage = schemaImages.length ? schemaImages : undefined;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${SITE_URL}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [ATTRACTION_SHORT_NAME, ATTRACTION_EN_NAME, `${CITY_SHORT}${ATTRACTION_SHORT_NAME}`],
  description: pageDescription,
  url: siteUrl,
  ...(schemaImage ? { image: schemaImage } : {}),
  telephone: TELEPHONE,
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: STREET_ADDRESS,
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL, GOVT_SCENIC_URL],
  openingHours: 'Mo-Su 11:00-20:00',
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: '例行清潔公休日',
      value: '每月第一個星期二；實際營業與攤位狀況以最新公告及現場為準'
    },
    {
      '@type': 'PropertyValue',
      name: 'Google Plus Code',
      value: PLUS_CODE
    },
    {
      '@type': 'PropertyValue',
      name: '景點類型',
      value: ATTRACTION_TYPE
    }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: RATING_VALUE,
    reviewCount: RATING_COUNT,
    bestRating: 5
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${SITE_URL}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: `${COUNTRY_NAME}${STATE_PROVINCE}`, item: `${SITE_URL}/#location` },
    { '@type': 'ListItem', position: 3, name: CITY_NAME, item: `${SITE_URL}/#location` },
    { '@type': 'ListItem', position: 4, name: ATTRACTION_FULL_NAME, item: `${SITE_URL}/#attraction` }
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  alternateName: [ATTRACTION_SHORT_NAME, ATTRACTION_EN_NAME],
  inLanguage: 'zh-Hant-TW',
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  about: { '@id': `${SITE_URL}/#attraction` }
};

const faqs = [
  ['為什麼叫「華僑市場」？','官方觀光資料記載，早期東琉線渡船頭旁的路邊漁貨攤規模不大，返程遊客常大量採買，甚至整攤買下。攤販形容這些客人像出手闊綽的返鄉華僑，市場逐漸成形後便沿用「華僑市場」的稱呼。'],
  ['市場幾點營業？每月都有公休日嗎？','交通部觀光署頁面標示 11:00–20:00，並註明每月第一個星期二為清潔日公休；大鵬灣官方資料對起始時間另有接近中午的描述。營業時間可能因攤位與現場安排調整，建議出發前再查最新公告。'],
  ['需要購買門票嗎？','這裡是漁產品直銷與餐飲型市場。公開資料沒有列出固定的一般參觀門票金額；主要花費通常來自自行選購的漁貨、熟食或料理服務。若遇活動或個別服務另行收費，請依現場標示。'],
  ['建議停留多久？什麼時段比較適合？','若以逛市場、看漁產與簡單用餐為主，可預留約 1–2 小時；若還要前往漁港、東隆宮或大鵬灣，可安排半日。市場屬黃昏型魚市，中午後較有市場感；怕人潮者可避開週末與用餐尖峰。'],
  ['從高雄國際機場怎麼去？','可搭 9117／9117A 等客運方向前往東港，再依停靠站步行或轉乘；也可直接搭計程車或合法叫車服務。班次、停靠與車程會變動，請以當日運輸資訊為準。'],
  ['有停車場、廁所與無障礙設施嗎？','官方資料列有漁港周邊停車場；交通部觀光署並列出 2 間無障礙廁所、1 台輪椅借用以及無障礙斜坡。一般廁所、停車費率與可用車位仍以現場為準。'],
  ['不吃生食也適合來嗎？','適合。市場除鮮魚與生食，也有熟食、漁特產與可將選購漁貨交由料理的服務型態。對海鮮過敏或有特殊飲食需求者，應直接向攤位確認食材與交叉接觸風險。'],
  [`${ATTRACTION_FULL_NAME}在哪裡？地址與電話是什麼？`,`地址是${COUNTRY_NAME}${STATE_PROVINCE}${CITY_NAME}朝隆路39號（郵遞區號 ${POSTAL_CODE}），電話 ${TELEPHONE_DISPLAY}（${TELEPHONE}），Google Plus Code 為 ${PLUS_CODE}。導航可直接搜尋「${ATTRACTION_SHORT_NAME}」或「${ATTRACTION_FULL_NAME}」，也可以開啟 Google 地圖分享連結：${MAPS_SHARE_URL}`],
  [`${ATTRACTION_SHORT_NAME}的 Google 評分是多少？`,`本站引用 Google 地圖公開評分快照 ${RATING_VALUE}／5（約 ${RATING_COUNT.toLocaleString('en-US')} 則）。這是會變動的第三方資料，僅供參考，實際數值請以 Google 地圖即時頁面為準。`],
  [`逛${ATTRACTION_SHORT_NAME}需要門票嗎？`,`不需要。${ATTRACTION_FULL_NAME}是開放式的漁產品直銷與餐飲市場，入場參觀免費；實際支出來自自行選購的漁貨、熟食、漁特產與代客料理等服務。`],
  [`${ATTRACTION_SHORT_NAME}附近有哪些順遊景點？`,`可串聯${NEARBY_LANDMARK_1}、${NEARBY_LANDMARK_2}、大鵬灣濕地與東琉線碼頭。時間有限時，建議以「市場＋${NEARBY_LANDMARK_1}＋港區散步」作為半日主軸。`],
  ['市場內可以刷卡或使用行動支付嗎？','各攤位提供的支付方式不同，部分攤位僅收現金。建議同時備妥現金與至少一種行動支付，並在消費前確認是否另收手續費或低消限制。'],
  ['連假或黑鮪魚季會不會很擠？','東港黑鮪魚文化觀光季、週末與連假人潮較多，停車與用餐等候時間通常拉長。想安靜看魚貨與拍照，可選擇平日下午剛開市的時段。'],
  ['華僑市場必吃什麼？有哪些海鮮美食推薦？','市場以新鮮漁獲與現流海鮮為核心：黑鮪魚生魚片、油旗魚黑輪（旗魚黑輪）、各式生魚片與熟食小炒都很常見；也能把選購的漁貨交由攤位代客料理。實際品項、價格與是否有季節限定，會隨漁況與攤位而異，建議現場看新鮮度與標價再決定。']
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/#faq`,
  mainEntity: faqs.map(([q,a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};

const mapSrc = MAPS_EMBED_SRC;
---
<BaseLayout title={pageTitle} description={pageDescription} image={metaImage} imageAlt={`${ATTRACTION_FULL_NAME} - ${CITY_NAME}海鮮市場主視覺`} jsonLd={[websiteSchema, attractionSchema, breadcrumbSchema, faqSchema]}>
  <section class="relative min-h-[76vh] overflow-hidden bg-[#062e36] text-white">
    <img src={imageUrl} alt={`${ATTRACTION_FULL_NAME} - ${CITY_NAME}海鮮市場主視覺（${COUNTRY_NAME}${STATE_PROVINCE}）`} class="absolute inset-0 h-full w-full object-cover opacity-65" referrerpolicy="no-referrer" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#042c35]/95 via-[#073b43]/75 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#062e36] to-transparent"></div>
    <div class="photo-credit absolute right-4 top-4 z-10">市場外觀｜交通部觀光署公開景點圖片</div>
    <div class="shell relative grid min-h-[76vh] items-end gap-8 pb-16 pt-24 lg:grid-cols-[1.25fr_.75fr]">
      <div>
        <nav aria-label="麵包屑" class="mb-5 flex flex-wrap items-center gap-2 text-xs font-bold text-[#a9c7c3]">
          <span>{COUNTRY_NAME}</span><span aria-hidden="true">›</span>
          <span>{STATE_PROVINCE}</span><span aria-hidden="true">›</span>
          <span>{CITY_NAME}</span><span aria-hidden="true">›</span>
          <span aria-current="page" class="text-[#ffd773]">{ATTRACTION_FULL_NAME}</span>
        </nav>
        <div class="mb-5 flex flex-wrap gap-2"><span class="badge !border-white/25 !bg-white/12 !text-white">屏東・東港</span><span class="badge !border-white/25 !bg-white/12 !text-white">漁港文化 × 黃昏魚市</span><span class="badge !border-white/25 !bg-white/12 !text-white">★ {RATING_VALUE}（{RATING_COUNT.toLocaleString('en-US')} 則）</span></div>
        <p class="text-sm font-extrabold tracking-[.24em] text-[#ffd773]">{ATTRACTION_EN_NAME}</p>
        <h1 class="mt-3 max-w-4xl text-[clamp(1.95rem,5.2vw,4.4rem)] font-black leading-[1.04] tracking-[-.045em]">{ATTRACTION_FULL_NAME}｜{STATE_PROVINCE}{CITY_SHORT}<br/><span class="text-[#ffd773]">海味上岸的地方</span></h1>
        <p class="mt-7 max-w-2xl text-lg text-[#d7e9e6]">不是只為「吃海鮮」而來。這裡更像一堂正在發生的東港漁業課：看魚貨、看市場如何分區，也看渡船、漁港與大鵬灣如何共同塑造這座海邊城鎮。</p>
        <p class="mt-4 max-w-2xl text-base text-[#c3dbd7]">位於{STATE_PROVINCE}{CITY_NAME}的{ATTRACTION_FULL_NAME}，也就是多數人口中的<strong class="text-white">{ATTRACTION_SHORT_NAME}</strong>，是東港漁港旁最主要的海鮮與漁產品直銷據點；逛市場、看魚貨、往來小琉球與大鵬灣的人流，都在這裡交會。</p>
      </div>
      <div class="ticket p-6">
        <p class="text-xs font-extrabold tracking-[.2em] text-[#ffd773]">行前速覽</p>
        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-5 text-sm">
          <div><dt class="text-[#9fc5c1]">官方時間</dt><dd class="mt-1 font-extrabold">11:00–20:00*</dd></div>
          <div><dt class="text-[#9fc5c1]">清潔公休</dt><dd class="mt-1 font-extrabold">每月第一個星期二</dd></div>
          <div><dt class="text-[#9fc5c1]">建議停留</dt><dd class="mt-1 font-extrabold">約 1–2 小時</dd></div>
          <div><dt class="text-[#9fc5c1]">地址</dt><dd class="mt-1 font-extrabold">{STATE_PROVINCE}{CITY_NAME}朝隆路 39 號</dd></div>
          <div><dt class="text-[#9fc5c1]">電話</dt><dd class="mt-1 font-extrabold"><a href={`tel:${TELEPHONE}`} class="hover:text-[#ffd773]">{TELEPHONE_DISPLAY}</a></dd></div>
          <div><dt class="text-[#9fc5c1]">Google 評分</dt><dd class="mt-1 font-extrabold">★ {RATING_VALUE}／5（{RATING_COUNT.toLocaleString('en-US')} 則）</dd></div>
        </dl>
        <p class="mt-5 border-t border-white/15 pt-4 text-xs text-[#bbd4d0]">* 公開官方資料對開始營業時間有些微差異，出發前請以最新公告與現場為準。</p>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="shell grid gap-10 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="eyebrow">景點檔案</p>
        <h2 class="h2">關於{ATTRACTION_FULL_NAME}</h2>
        <p class="lead">歡迎來到<strong>{ATTRACTION_FULL_NAME}</strong>，也就是廣為人知、位於{STATE_PROVINCE}{CITY_NAME}的<strong>{ATTRACTION_SHORT_NAME}</strong>（{ATTRACTION_EN_NAME}）。它坐落在東港漁港旁，是這座海邊城鎮最主要的{ATTRACTION_TYPE}與漁產品直銷據點，也是旅客認識東港漁業的第一站。</p>
        <p class="mt-5 text-[#456267]">地理歸屬層級：<strong class="text-[#092f37]">{ATTRACTION_FULL_NAME}</strong> → <strong class="text-[#092f37]">{CITY_NAME}</strong> → <strong class="text-[#092f37]">{STATE_PROVINCE}</strong> → <strong class="text-[#092f37]">{COUNTRY_NAME}</strong>。完整的地址是{COUNTRY_NAME}{STATE_PROVINCE}{CITY_NAME}朝隆路39號（{POSTAL_CODE}），Google Plus Code 為 {PLUS_CODE}。</p>
        <p class="mt-5 text-[#456267]">走訪{ATTRACTION_FULL_NAME}時，也能順道探索周邊的歷史地標與景點，包括<strong class="text-[#092f37]">{NEARBY_LANDMARK_1}</strong>與<strong class="text-[#092f37]">{NEARBY_LANDMARK_2}</strong>；步行或短程車程即可把市場、信仰地景與大鵬灣串成半日行程。</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#0b6871] px-5 py-3 text-sm font-black text-white">Google 地圖分享連結</a>
          <a href={GOVT_TOURISM_URL} target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#092f37]/20 bg-white px-5 py-3 text-sm font-black">交通部觀光署景點資料</a>
          <a href={`tel:${TELEPHONE}`} class="rounded-full border border-[#092f37]/20 bg-white px-5 py-3 text-sm font-black">電話 {TELEPHONE_DISPLAY}</a>
        </div>
      </div>
      <div class="card p-7 md:p-8">
        <p class="eyebrow">實體名片</p>
        <dl class="mt-5 space-y-4 text-sm">
          <div><dt class="text-[#6d8589]">官方全稱</dt><dd class="mt-1 font-extrabold text-[#092f37]">{ATTRACTION_FULL_NAME}</dd></div>
          <div><dt class="text-[#6d8589]">常用稱呼／別名</dt><dd class="mt-1 font-extrabold text-[#092f37]">{ATTRACTION_SHORT_NAME}、{CITY_SHORT}{ATTRACTION_SHORT_NAME}、{ATTRACTION_EN_NAME}</dd></div>
          <div><dt class="text-[#6d8589]">景點類型</dt><dd class="mt-1 font-extrabold text-[#092f37]">{ATTRACTION_TYPE}／漁產品直銷中心</dd></div>
          <div><dt class="text-[#6d8589]">地址</dt><dd class="mt-1 font-extrabold text-[#092f37]">{COUNTRY_NAME}{STATE_PROVINCE}{CITY_NAME}朝隆路39號（{POSTAL_CODE}）</dd></div>
          <div><dt class="text-[#6d8589]">座標</dt><dd class="mt-1 font-extrabold text-[#092f37]">{LATITUDE}, {LONGITUDE}｜Plus Code {PLUS_CODE}</dd></div>
          <div><dt class="text-[#6d8589]">電話</dt><dd class="mt-1 font-extrabold text-[#092f37]"><a href={`tel:${TELEPHONE}`} class="underline decoration-[#0b6871]/30 underline-offset-4">{TELEPHONE_DISPLAY}</a></dd></div>
          <div><dt class="text-[#6d8589]">Google 評分</dt><dd class="mt-1 font-extrabold text-[#092f37]">★ {RATING_VALUE}／5（{RATING_COUNT.toLocaleString('en-US')} 則，第三方公開快照）</dd></div>
          <div><dt class="text-[#6d8589]">入場</dt><dd class="mt-1 font-extrabold text-[#092f37]">免門票；消費為自行選購</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section market-grid" id="story">
    <div class="shell grid gap-12 lg:grid-cols-[.82fr_1.18fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">市場故事</p><h2 class="h2">{ATTRACTION_SHORT_NAME}的歷史與意義：從渡船頭魚攤到{ATTRACTION_FULL_NAME}</h2>
      </div>
      <div class="space-y-8">
        <div class="card p-7 md:p-9">
          <h3 class="text-2xl font-black">「華僑」不是族群名稱，而是一段市場口耳相傳的比喻</h3>
          <p class="mt-4 text-[#456267]">交通部觀光署記錄了一段在地說法：早年渡船頭周邊的漁貨攤規模小、數量有限，小琉球返程遊客常在回家前一次大量採買，甚至整攤買走。攤販把這種豪爽消費比作「返鄉華僑」，固定市場形成後，「華僑市場」也就成了廣為人知的名字。</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <div class="card p-7"><div class="text-5xl font-black text-[#bb3026]">2012</div><h3 class="mt-2 font-black">原址重建後的新階段</h3><p class="mt-2 text-sm text-[#456267]">舊市場因老舊重建，2012 年 5 月完工啟用，正式名稱改為「東港漁港漁產品直銷中心」。</p></div>
