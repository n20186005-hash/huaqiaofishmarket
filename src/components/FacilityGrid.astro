---
import { CITY_NAME, STATE_PROVINCE, ATTRACTION_SHORT_NAME } from '../data/site';

const facilities = [
  {
    icon: '🚻',
    title: '廁所與盥洗',
    types: ['市場內外公共廁所', '無障礙廁所', '簡易洗手／清洗台'],
    text: '交通部觀光署資料列出 2 間無障礙廁所、1 台輪椅借用與無障礙斜坡。一般廁所位置、清潔時段與可用數量以現場標示為準；市場作業區周邊可能因清洗魚貨而濕滑。'
  },
  {
    icon: '💧',
    title: '飲水與補給',
    types: ['飲水機或補水點', '市區超商與雜貨店', '自備水壺'],
    text: '南部氣候溫暖，逛市場與港區步行容易流汗。建議自備水壺並在市區補給；是否能飲用現場水源請依現場標示，不確定时以瓶裝水為主。'
  },
  {
    icon: '🅿️',
    title: '停車（汽車／機車／大型車／無障礙車位）',
    types: ['漁港周邊停車場', '路邊停車格', '臨時活動停車空間'],
    text: '官方資料列有鄰近停車場；車位數量、費率、收費方式與出入口以現場公告為準。連假與渡船尖峰容易壅塞，建議提早抵達或改停外圍再步行進入。'
  },
  {
    icon: '🍽️',
    title: '餐飲（只講類型，不推薦店家）',
    types: ['市場內熟食與小吃', '代客料理服務', '市區海鮮餐飲', '素食與其他飲食需求'],
    text: '本站不接受商業置入，也不替特定店家排名。選擇時可先看標價、環境衛生與排隊動線；特殊飲食需求（過敏、素食、宗教飲食）請直接向攤位確認食材與處理方式。'
  },
  {
    icon: '🛏️',
    title: '住宿',
    types: ['合法旅館與旅店', '民宿', '長住型住宿'],
    text: '若要搭早班船、看港區晨昏或串聯大鵬灣，可依需求選擇東港鎮周邊的合法住宿類型，並在臺灣旅宿網確認登記與營業狀態；本站不代訂也不推薦特定業者。'
  },
  {
    icon: '🛒',
    title: '商超與採買',
    types: ['便利商店', '超市與量販', '傳統市場', '保冷袋、冰塊與打包用品'],
    text: '東港市區可補充飲水、雨具、保冷袋、日用品與簡易藥品。買生鮮後若要長途攜帶，保冷與縮短常溫時間比什麼都重要；請依步行距離與營業時間自行選擇。'
  },
  {
    icon: '⛽',
    title: '加油與電動車充電',
    types: ['加油站', '停車場充電樁', '公共充電站'],
    text: '漁港與東港市區周邊有加油服務。電動車充電點與規格變動較快，出發前請以車廠、停車場或公用充電即時資訊確認可用性、功率與接頭規格。'
  },
  {
    icon: '💊',
    title: '醫療與藥局',
    types: ['衛生所與診所', '社區藥局', '急救與消防資源'],
    text: '輕症可諮詢社區藥局；緊急狀況請撥 119（消防救護）或 110（警察）。海鮮過敏者建議隨身攜帶醫師開立的藥物，並在用餐前主動告知店家。'
  },
  {
    icon: '💳',
    title: '金融與支付',
    types: ['ATM 與金融機構', '現金交易', '行動支付與卡片'],
    text: '各攤位提供的支付方式不同，部分攤位僅收現金。建議同時備妥現金與至少一種行動支付；是否在付款時另收手續費或有低消限制，請於消費前確認。'
  },
  {
    icon: '♿',
    title: '無障礙與親子',
    types: ['無障礙斜坡', '輪椅借用', '無障礙廁所', '推車動線'],
    text: '觀光署資料列有無障礙斜坡、輪椅借用與無障礙廁所；但市場為作業場域，走道寬度會受攤位與人流影響。帶嬰兒車或輪椅同行時，建議避開尖峰並預留更寬的通行時間。'
  },
  {
    icon: '🎒',
    title: '行李、寄物與寵物',
    types: ['自寄物設施', '住宿業者寄放服務', '寵物友善空間'],
    text: '公開資料未列出市場固定寄物設施，大型行李建議先於住宿或車內安置；市場人流與濕滑地面對寵物與行李都不友善。攜帶寵物請遵守現場規範並避免影響作業動線。'
  },
  {
    icon: '📶',
    title: '休息空間、網路與電源',
    types: ['公共休息座位', '樓頂觀海平台', '行動網路與店家電源'],
    text: '市場樓頂設有觀海平台，是可暫時離開人潮、看看漁港與海灣的休息點。公共電源與座位有限，若需要長時間使用，建議在市區咖啡或公共空間補給後再前往。'
  }
];
---

<section class="section" id="facilities">
  <div class="shell">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">旅行機能</p>
        <h2 class="h2">WC、停車、餐飲、住宿、商超、加油與充電：旅客真正會用到的周邊機能</h2>
      </div>
      <p class="max-w-lg text-sm text-[#557075]">
        以下只說明「設施類型與使用重點」，不推薦或排名任何特定業者、店家或場館。實際位置、營業時間與收費方式請以現場與主管單位公告為準。
      </p>
    </div>

    <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        facilities.map((item) => (
          <article class="card p-6 md:p-7">
            <div class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <h3 class="text-lg font-black">{item.title}</h3>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              {item.types.map((type) => <span class="badge !text-[.72rem]">{type}</span>)}
            </div>
            <p class="mt-4 text-sm text-[#526d72]">{item.text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-8 rounded-2xl border border-[#e2ad32]/40 bg-[#fff9df] p-6 text-sm text-[#5c4a12]">
      <strong>中立說明：</strong>本站為非營利資訊站，不收取任何店家、業者或平台的置入費用；文中提到的餐飲、住宿、商超、加油與充電都只是「服務類型」，不代表特定品牌或商戶的推薦，也不構成消費保證。實際服務內容、價格與可用性請自行向業者與主管機關查證。
    </div>
  </div>
</section>
