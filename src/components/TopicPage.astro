---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Topic } from '../data/topics/types';
import {
  SITE_NAME, SITE_URL, withSiteName,
  RATING_VALUE, RATING_COUNT, RATING_AS_OF,
  GOVT_TOURISM_URL, GOVT_SCENIC_URL
} from '../data/site';
import { TOPIC_GROUP_LABELS, resolveRelated, topicUrl } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;

const groupLabel = TOPIC_GROUP_LABELS[topic.group];
const related = resolveRelated(topic.related);

const pageTitle = withSiteName(topic.title.split('：')[0]);
const pageDescription = topic.description;

const currentUrl = SITE_URL + topicUrl(topic.slug);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: groupLabel, item: SITE_URL + '/#guides' },
    { '@type': 'ListItem', position: 3, name: topic.h1, item: currentUrl }
  ]
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': SITE_URL + '/#webpage',
  url: currentUrl,
  name: topic.h1,
  about: { '@id': SITE_URL + '/#attraction' }
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={[breadcrumbSchema, webPageSchema, faqSchema]}>
  <section class="relative overflow-hidden bg-[#062e36] text-white">
    <div class="shell grid gap-8 py-16 lg:grid-cols-[1.25fr_.75fr] lg:py-20">
      <div>
        <nav aria-label="麵包屑" class="mb-5 flex flex-wrap items-center gap-2 text-xs font-bold text-[#a9c7c3]">
          <a href={SITE_URL + '/'} class="hover:text-white">{SITE_NAME}</a><span aria-hidden="true">›</span>
          <a href={SITE_URL + '/#guides'} class="hover:text-white">{groupLabel}</a><span aria-hidden="true">›</span>
          <span aria-current="page" class="text-[#ffd773]">{topic.h1}</span>
        </nav>
        <p class="eyebrow !text-[#ffd773]">{groupLabel}</p>
        <h1 class="mt-2 text-[clamp(1.7rem,4.2vw,3.2rem)] font-black leading-[1.08] tracking-[-.03em]">{topic.h1}</h1>
        <p class="mt-5 max-w-2xl text-[#d7e9e6]">{topic.lead}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <span class="rounded-full bg-[#0b6871] px-5 py-3 text-sm font-black">Google 評分（{RATING_AS_OF}）{RATING_VALUE}／5（{RATING_COUNT.toLocaleString('en-US')} 則）</span>
          <a href={GOVT_TOURISM_URL} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/20 bg-white/5 px-5 py-3 text-sm font-black">交通部觀光署</a>
        </div>
      </div>
      <div class="ticket p-6">
        <p class="text-xs font-extrabold tracking-[.2em] text-[#ffd773]">本頁重點</p>
        <ul class="mt-4 space-y-3 text-sm">
          {topic.sections.slice(0, 4).map((s) => <li class="font-extrabold">{s.heading}</li>)}
        </ul>
        <p class="mt-5 border-t border-white/15 pt-4 text-xs text-[#bbd4d0]">本指南為第三方旅遊整理，最終以現場與主管單位公告為準。</p>
      </div>
    </div>
  </section>

  {
    topic.image && (
      <section class="section !pb-0">
        <div class="shell">
          <img src={topic.image} alt={topic.imageAlt ?? topic.h1} class="w-full rounded-[1.5rem] object-cover" />
          {topic.imageAlt && <p class="mt-3 text-center text-xs text-[#456267]">{topic.imageAlt}</p>}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="shell max-w-3xl">
      {topic.sections.map((section) => (
        <article class="mb-10">
          <h2 class="h2">{section.heading}</h2>
          {section.paragraphs?.map((p) => <p class="mt-4 text-lg leading-relaxed text-[#33484d]">{p}</p>)}
          {section.bullets && (
            <ul class="mt-5 space-y-3">
              {section.bullets.map((b) => (
                <li class="flex gap-3 text-lg text-[#33484d]"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-[#0b6871]"></span><span>{b}</span></li>
              ))}
            </ul>
          )}
          {section.callout && (
            <div class="mt-6 rounded-[1.25rem] border border-[#e2ad32]/40 bg-[#fff9df] p-5">
              <p class="text-sm text-[#5c4a12]">{section.callout}</p>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section bg-[#edf5f2]">
        <div class="shell">
          <p class="eyebrow">相關專題</p>
          <h2 class="h2">繼續探索東港華僑市場</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <a href={r.url} class="card p-7 transition hover:-translate-y-0.5 hover:shadow-md">
                <h3 class="text-xl font-black">{r.title}</h3>
                <span class="mt-4 inline-block text-sm font-black text-[#0b6871]">查看專題 →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-[#072f38] text-white" id="faq">
    <div class="shell max-w-3xl">
      <p class="eyebrow !text-[#ffd773]">FAQ</p>
      <h2 class="h2">關於「{topic.h1}」的常見問答</h2>
      <div class="mt-7 grid gap-4">
        {topic.faqs.map((f) => (
          <details class="card group bg-white p-6 text-[#23383d]">
            <summary class="cursor-pointer list-none pr-8 text-lg font-black">{f.q}</summary>
            <p class="mt-4 border-t border-[#0b6871]/10 pt-4 text-[#526d72]">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-6 text-xs text-[#9fc5c1]">本頁最後更新：{topic.updated}。內容為第三方旅遊整理，實際情形以現場與主管單位公告為準。</p>
    </div>
  </section>

  <section class="section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">獨立第三方聲明</p>
      <p class="mt-3 text-sm text-[#456267]">
        本網站為非營利、獨立第三方旅遊指南，與華僑市場（{SITE_NAME}）的攤商、管理單位無隸屬或商業關係。
        頁面內容僅整理公開資料與通用經驗，不替任何店家排名或背書；實際營業、價格、船班與設施請以現場標價與主管或營運單位公告為準。
      </p>
      <p class="mt-4 text-sm text-[#456267]">
        資料來源：交通部觀光署、大鵬灣國家風景區管理處、Google 地圖公開評分快照（{RATING_AS_OF}）。
      </p>
    </div>
  </section>
</BaseLayout>
