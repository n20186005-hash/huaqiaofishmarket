---
import Logo from './Logo.astro';
import { MAPS_SHARE_URL } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-[#0b6871]/10 bg-[#fffdf6]/92 backdrop-blur-xl">
  <div class="shell flex min-h-18 items-center justify-between gap-5 py-3">
    <Logo />
    <button id="mobile-menu-toggle" class="lg:hidden rounded-full border px-3 py-2" type="button" aria-expanded="false" aria-controls="mobile-menu">選單</button>
    <nav aria-label="主要導覽" class="hidden items-center gap-5 lg:flex">
      <a class="nav-link" href="/#about">關於市場</a>
      <a class="nav-link" href="/#story">市場故事</a>
      <a class="nav-link" href="/#visit">行前資訊</a>
      <a class="nav-link" href="/#transport">詳細交通</a>
      <a class="nav-link" href="/#facilities">現場機能</a>
      <a class="nav-link" href="/#nearby">周邊景點</a>
      <a class="nav-link" href="/#faq">FAQ</a>
      <a class="nav-link" href="/hours/">營業時間</a>
      <a class="nav-link" href="/parking/">停車交通</a>
      <a class="nav-link" href="/food/">美食推薦</a>
    </nav>
    <a href={MAPS_SHARE_URL} rel="noopener noreferrer" target="_blank" class="rounded-full bg-[#bb3026] px-4 py-2 text-sm font-extrabold text-white shadow-sm transition hover:-translate-y-0.5">開啟地圖</a>
  </div>
  <nav id="mobile-menu" hidden aria-label="手機導覽" class="shell mobile-menu"><a href="/#about">關於市場</a><a href="/#story">市場故事</a><a href="/#visit">行前資訊</a><a href="/#transport">交通</a><a href="/#facilities">設施確認</a><a href="/#nearby">周邊景點</a><a href="/#weather">天氣潮汐</a><a href="/#faq">問答</a><a href="/hours/">營業時間</a><a href="/parking/">停車交通</a><a href="/food/">美食指南</a></nav>
</header>
